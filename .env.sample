# Blocklandia environment variables.
# Copy to `.env` and fill in real values. Never commit secrets.

# --- Web client (apps/web) ---

# Secret for the /admin panel and /api/admin/* routes. Sent as the `x-admin-key` header.
# Required in production; locally it defaults to a dev value.
ADMIN_KEY=dev-admin-secret

# Base URL of the Rust internal data API the web app proxies to. Defaults to
# http://localhost:8080 when unset.
RUST_API_URL=http://localhost:8080

# Shared secret for the HMAC-signed Next -> Rust internal channel. Must match the
# server's INTERNAL_HMAC_SECRET. Required; no fallback.
INTERNAL_HMAC_SECRET=bl-internal-test-secret

# Fallback tenant id when none is resolved from `?tenant=` or the subdomain.
NEXT_PUBLIC_DEFAULT_TENANT=teo

# --- Multiplayer server (apps/server) ---

# Secret for GET /admin/stats. Sent as the `x-admin-token` header.
ADMIN_TOKEN=dev-admin-secret

# Shared secret for the HMAC-signed Next -> Rust internal channel. Must match the
# web app's INTERNAL_HMAC_SECRET. Required; the server refuses to start without it.
INTERNAL_HMAC_SECRET=bl-internal-test-secret

# Local libSQL database file path. A Turso URL + token swaps in later without code
# changes. Defaults to ./data/blocklandia.db when unset.
DATABASE_PATH=./data/blocklandia.db

# Address the server binds to.
BIND=0.0.0.0:8080

# Log filter (tracing/env_logger syntax).
RUST_LOG=info,server=debug

# Path to a tenants.toml override. When unset, the bundled apps/server/tenants.toml is used.
TENANTS_FILE=
