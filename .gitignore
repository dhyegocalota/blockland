# Local env files with secrets (.env.sample stays tracked as the template)
.env
.env*.local
npm-debug.log*
.playwright-mcp
*.jpeg
target
.data
*.tsbuildinfo

# Generated build artifact: the bundled offline tenant (see scripts/bundle-tenant.mjs)
apps/web/public/tenant.json

# Generated WASM offline core: the heavy .wasm + wasm-bindgen JS (regenerated by
# apps/server/crates/game-core-wasm/build-wasm.sh; the wrapper source + script + README stay tracked).
apps/web/lib/wasm/

# Rust server runtime data (libSQL db, bans, world saves, uploads) — `data/` lands next to whatever
# cwd the server runs from (apps/server or crates/server), so ignore it at any depth under apps/server.
apps/server/**/data/
.vercel
